{
  "name": "pokemon-database-agentic",
  "version": "1.0.0",
  "description": "A practice project for agentic applications with Pokemon search",
  "private": true,
  "packageManager": "npm@10.0.0",
  "workspaces": [
    "app/client",
    "app/server",
    "agent"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:client": "turbo run dev --filter=@pokemon-db/client",
    "dev:server": "turbo run dev --filter=@pokemon-db/server",
    "dev:agent": "turbo run dev --filter=@pokemon-db/agent",
    "build:client": "turbo run build --filter=@pokemon-db/client",
    "build:server": "turbo run build --filter=@pokemon-db/server",
    "start:server": "turbo run start --filter=@pokemon-db/server"
  },
  "keywords": [
    "pokemon",
    "agentic",
    "nodejs",
    "vercel"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "turbo": "^2.8.9"
  }
}
