{
  "version": 2,
  "buildCommand": "(cd app/client && npm install && npm run build)",
  "outputDirectory": "app/client/dist",
  "devCommand": "npm run dev:client",
  "installCommand": "echo 'Skipping root install'",
  "framework": null,
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
