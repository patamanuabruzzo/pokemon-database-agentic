# (REQUIRED) Anthropic Configuration to run Claude Code in programmatic mode
ANTHROPIC_API_KEY=

# (Optional) Claude Code Path - if 'claude' does not work run 'which claude' and paste that value here
CLAUDE_CODE_PATH=claude

# (Optional) Returns claude code to the root directory after every command
CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true

# ===========================
# Logging Configuration
# ===========================

# (Optional) Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Default: INFO
LOG_LEVEL=INFO

# (Optional) Log format: json (for production/structured logging) or text (for development/human-readable)
# Default: text
LOG_FORMAT=text

# (Optional) Path to log file for file-based logging
# Default: None (no file logging unless specified)
# Example: LOG_FILE=logs/app.log
LOG_FILE=

# (Optional) Enable/disable console logging
# Default: true
LOG_TO_CONSOLE=true

# (Optional) Enable/disable file logging
# Default: false (enabled only if LOG_FILE is set)
LOG_TO_FILE=false

# ===========================
# GitHub Webhook Configuration
# ===========================

# GitHub webhook secret for signature verification
# Generate with: openssl rand -hex 32
# Set this in GitHub webhook settings and here
GITHUB_WEBHOOK_SECRET=

# ===========================
# Pokemon Database Application Configuration
# ===========================

# Server Configuration
PORT=3001
NODE_ENV=development

# API Configuration
POKEAPI_BASE_URL=https://pokeapi.co/api/v2
